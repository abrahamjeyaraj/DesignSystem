{
  "$description": "Shared structure and defaults. Every theme gets the same role names and scale keys; a theme may override the values of fontFamily, fontSize, fontWeight, lineHeight, radius, shadow and label, never add or remove keys. Dimensions are unitless px (web rem = px / 16, SwiftUI pt, Compose dp/sp, Flutter logical px).",
  "palette": {
    "white": "#ffffff",
    "black": "#000000"
  },
  "roles": [
    "background",
    "foreground",
    "card",
    "card-foreground",
    "popover",
    "popover-foreground",
    "primary",
    "primary-foreground",
    "secondary",
    "secondary-foreground",
    "muted",
    "muted-foreground",
    "accent",
    "accent-foreground",
    "destructive",
    "destructive-foreground",
    "border",
    "input",
    "ring",
    "success",
    "success-light",
    "warning",
    "warning-light",
    "error",
    "error-light",
    "info",
    "info-light",
    "ink",
    "ink-body",
    "ink-muted",
    "subtle",
    "line",
    "line-hover",
    "action",
    "action-foreground",
    "surface-card",
    "surface-sand",
    "accent-2",
    "ink-900",
    "on-ink",
    "on-ink-muted",
    "on-ink-accent",
    "warn-bg",
    "alert-bg"
  ],
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 16,
    "control": 6,
    "button": 6,
    "card": 8,
    "full": 9999
  },
  "fontSize": {
    "xs": 12,
    "sm": 14,
    "base": 16,
    "lg": 18,
    "xl": 20,
    "2xl": 24,
    "3xl": 30,
    "4xl": 36,
    "5xl": 48
  },
  "fontWeight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800,
    "black": 900
  },
  "lineHeight": {
    "tight": 1.2,
    "normal": 1.5,
    "relaxed": 1.75
  },
  "fontFamily": {
    "sans": {
      "family": "Inter",
      "webVar": "--font-inter",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "heading": {
      "family": "Inter",
      "webVar": "--font-inter",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "body": {
      "family": "Inter",
      "webVar": "--font-inter",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "family": "ui-monospace",
      "fallback": [
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    },
    "label": {
      "family": "Inter",
      "webVar": "--font-inter",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "label": {
    "case": "none",
    "tracking": 0,
    "size": 14,
    "weight": 500
  },
  "shadow": {
    "sm": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.05
      }
    ],
    "DEFAULT": [
      {
        "x": 0,
        "y": 1,
        "blur": 3,
        "spread": 0,
        "alpha": 0.1
      },
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": -1,
        "alpha": 0.1
      }
    ],
    "md": [
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -1,
        "alpha": 0.1
      },
      {
        "x": 0,
        "y": 2,
        "blur": 4,
        "spread": -2,
        "alpha": 0.1
      }
    ],
    "lg": [
      {
        "x": 0,
        "y": 10,
        "blur": 15,
        "spread": -3,
        "alpha": 0.1
      },
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -4,
        "alpha": 0.1
      }
    ],
    "xl": [
      {
        "x": 0,
        "y": 20,
        "blur": 25,
        "spread": -5,
        "alpha": 0.1
      },
      {
        "x": 0,
        "y": 8,
        "blur": 10,
        "spread": -6,
        "alpha": 0.1
      }
    ],
    "card": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.05
      }
    ],
    "pop": [
      {
        "x": 0,
        "y": 4,
        "blur": 16,
        "spread": 0,
        "alpha": 0.08
      },
      {
        "x": 0,
        "y": 12,
        "blur": 32,
        "spread": 0,
        "alpha": 0.1
      }
    ]
  },
  "duration": {
    "fast": 150,
    "base": 200,
    "medium": 300,
    "slow": 500
  },
  "easing": {
    "standard": [
      0.4,
      0,
      0.2,
      1
    ],
    "in": [
      0.4,
      0,
      1,
      1
    ],
    "out": [
      0,
      0,
      0.2,
      1
    ]
  },
  "zIndex": {
    "base": 0,
    "dropdown": 10,
    "sticky": 20,
    "fixed": 30,
    "modalBackdrop": 40,
    "modal": 50,
    "popover": 60,
    "tooltip": 70
  },
  "breakpoint": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "mobile": {
    "type": {
      "title": {
        "font": "heading",
        "size": 28,
        "lineHeight": 34,
        "weight": 700
      },
      "headline": {
        "font": "heading",
        "size": 20,
        "lineHeight": 26,
        "weight": 600
      },
      "body": {
        "font": "body",
        "size": 16,
        "lineHeight": 24,
        "weight": 400
      },
      "label": {
        "font": "label",
        "size": 14,
        "lineHeight": 20,
        "weight": 600
      },
      "caption": {
        "font": "body",
        "size": 12,
        "lineHeight": 16,
        "weight": 400
      }
    },
    "layout": {
      "gutter": 16,
      "sectionGap": 24,
      "itemGap": 12,
      "touchTarget": 44,
      "controlHeight": 48,
      "fieldHeight": 48,
      "cardRadius": 12,
      "sheetRadius": 20
    }
  },
  "supportsDark": true,
  "minTouchTarget": 44
}
