{
  "$description": "TheBibleProject: cream ground, gold primary, ink text, iPhone-dark #121210 background in dark mode. Playfair Display headings, Geist body, IBM Plex Mono uppercase labels. Values match TheBibleProject/apps/web/src/app/globals.css (shadcn names) on 2026-09-24. Colour values are #rrggbb or {palette.step}; dark lists overrides only. Bible-only content colours (red-letter text, bookmark colours) stay in the app.",
  "name": "bible",
  "palette": {
    "indigo": {
      "50": "#f1f3f9",
      "100": "#dfe3f1",
      "200": "#c7d2eb",
      "300": "#a7c1dc",
      "400": "#81a3cc",
      "500": "#6385bc",
      "600": "#4f6ba7",
      "700": "#3d4d7a",
      "800": "#313d61",
      "900": "#293351"
    },
    "sky": {
      "50": "#f0f7fc",
      "100": "#dceef9",
      "700": "#2f6b8c"
    },
    "emerald": {
      "50": "#eef7f2",
      "100": "#d5eddf",
      "700": "#2d6b4a"
    },
    "rose": {
      "50": "#faf2f2",
      "100": "#f4e1e1",
      "700": "#9c4242"
    }
  },
  "tailwindAliases": {
    "indigo": "indigo",
    "sky": "sky",
    "emerald": "emerald",
    "rose": "rose"
  },
  "fontFamily": {
    "heading": {
      "family": "Playfair Display",
      "webVar": "--font-playfair",
      "fallback": [
        "serif"
      ]
    },
    "body": {
      "family": "Geist",
      "webVar": "--font-geist",
      "fallback": [
        "sans-serif"
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "webVar": "--font-ibm-plex-mono",
      "fallback": [
        "monospace"
      ]
    },
    "label": {
      "family": "IBM Plex Mono",
      "webVar": "--font-ibm-plex-mono",
      "fallback": [
        "monospace"
      ]
    }
  },
  "fontSize": {
    "base": 15
  },
  "radius": {
    "control": 2,
    "button": 2,
    "card": 8
  },
  "label": {
    "case": "uppercase",
    "tracking": 1.5,
    "size": 13,
    "weight": 500
  },
  "shadow": {
    "sm": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.08
      }
    ],
    "DEFAULT": [
      {
        "x": 0,
        "y": 2,
        "blur": 4,
        "spread": 0,
        "alpha": 0.08
      },
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": -1,
        "alpha": 0.06
      }
    ],
    "md": [
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -1,
        "alpha": 0.12
      },
      {
        "x": 0,
        "y": 2,
        "blur": 4,
        "spread": -2,
        "alpha": 0.08
      }
    ],
    "lg": [
      {
        "x": 0,
        "y": 10,
        "blur": 15,
        "spread": -3,
        "alpha": 0.12
      },
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -4,
        "alpha": 0.08
      }
    ],
    "xl": [
      {
        "x": 0,
        "y": 20,
        "blur": 25,
        "spread": -5,
        "alpha": 0.14
      },
      {
        "x": 0,
        "y": 8,
        "blur": 10,
        "spread": -6,
        "alpha": 0.1
      }
    ],
    "card": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.08
      }
    ]
  },
  "light": {
    "background": "#f4f2ef",
    "foreground": "#1a1a1a",
    "card": "{white}",
    "card-foreground": "#1a1a1a",
    "popover": "{white}",
    "popover-foreground": "#1a1a1a",
    "primary": "#c8b496",
    "primary-foreground": "#1a1a1a",
    "secondary": "#f5f2ed",
    "secondary-foreground": "#1a1a1a",
    "muted": "#f5f2ed",
