      "700": "#2f6b8c"
    },
    "emerald": {
      "50": "#eef7f2",
      "100": "#d5eddf",
      "700": "#2d6b4a"
    },
    "rose": {
      "50": "#faf2f2",
      "100": "#f4e1e1",
      "700": "#9c4242"
    }
  },
  "scales": {
    "primary": "stone",
    "secondary": "stone",
    "accent": "sienna"
  },
  "tailwindAliases": {
    "gray": "stone",
    "slate": "stone",
    "blue": "stone",
    "amber": "sienna",
    "indigo": "indigo",
    "sky": "sky",
    "emerald": "emerald",
    "rose": "rose"
  },
  "fontFamily": {
    "heading": {
      "family": "Playfair Display",
      "webVar": "--font-playfair",
      "fallback": [
        "serif"
      ]
    },
    "body": {
      "family": "Geist",
      "webVar": "--font-geist",
      "fallback": [
        "sans-serif"
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "webVar": "--font-ibm-plex-mono",
      "fallback": [
        "monospace"
      ]
    },
    "label": {
      "family": "IBM Plex Mono",
      "webVar": "--font-ibm-plex-mono",
      "fallback": [
        "monospace"
      ]
    }
  },
  "fontSize": {
    "base": 15
  },
  "radius": {
    "control": 2,
    "button": 2,
    "card": 8
  },
  "label": {
    "case": "uppercase",
    "tracking": 1.5,
    "size": 13,
    "weight": 500
  },
  "shadow": {
    "sm": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.08
      }
    ],
    "DEFAULT": [
      {
        "x": 0,
        "y": 2,
        "blur": 4,
        "spread": 0,
        "alpha": 0.08
      },
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": -1,
        "alpha": 0.06
      }
    ],
    "md": [
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -1,
        "alpha": 0.12
      },
      {
        "x": 0,
        "y": 2,
        "blur": 4,
        "spread": -2,
        "alpha": 0.08
      }
    ],
    "lg": [
      {
        "x": 0,
        "y": 10,
        "blur": 15,
        "spread": -3,
        "alpha": 0.12
      },
      {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -4,
        "alpha": 0.08
      }
    ],
    "xl": [
      {
        "x": 0,
        "y": 20,
        "blur": 25,
        "spread": -5,
        "alpha": 0.14
      },
      {
        "x": 0,
        "y": 8,
        "blur": 10,
        "spread": -6,
        "alpha": 0.1
      }
    ],
    "card": [
      {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "alpha": 0.08
      }
    ]
  },
