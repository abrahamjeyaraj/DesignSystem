    "warning-light": "#fcf5e5",
    "error": "#a83c3c",
    "error-light": "#fceaea",
    "info": "#4a5d73",
    "info-light": "#e8ecf1",
    "ink": "#1a1a1a",
    "ink-body": "#4a4a4a",
    "ink-muted": "#666666",
    "subtle": "#f4f2ef",
    "line": "#e5e0d8",
    "line-hover": "#e0dcd4",
    "action": "#c8b496",
    "action-foreground": "#1a1a1a",
    "surface-card": "{white}",
    "surface-sand": "#f5f2ed",
    "accent-2": "#b07c4b",
    "ink-900": "#1a1a1a",
    "on-ink": "#f4f2ef",
