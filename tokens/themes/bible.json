      "500": "#c97a54",
      "600": "#b25d38",
      "700": "#8f4a2c",
      "800": "#6b3820",
      "900": "#482717"
    },
    "indigo": {
      "50": "#f1f3f9",
      "100": "#dfe3f1",
      "200": "#c7d2eb",
