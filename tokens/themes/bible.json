    "card-foreground": "#f3f1ec",
    "popover": "#232118",
    "popover-foreground": "#f3f1ec",
    "primary": "#d9c9a8",
    "primary-foreground": "#1a1a1a",
    "secondary": "#26241e",
    "secondary-foreground": "#f3f1ec",
    "muted": "#26241e",
