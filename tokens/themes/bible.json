    "on-ink": "#121210",
    "on-ink-muted": "#666666",
    "on-ink-accent": "#8a5a2e"
  },
  "extra": {
    "$description": "Bible web colours beyond the shared roles, under the names apps/web uses. Emitted as --color-<name> in CSS and as an extras map on native.",
    "light": {
      "body": "#4a4a4a",
      "placeholder": "#bbbbbb",
      "border-subtle": "#eeece8",
      "border-strong": "#e0dcd4",
      "footer": "#f8f7f5",
      "surface-dark": "#1e1e1e",
      "surface-dark-warm": "#29261b",
      "brand-blue": "#384f84",
      "brand-brown": "#b07c4b",
      "brand-brown-strong": "#8a5a2e"
    },
    "dark": {
      "body": "#c9c5bd",
      "border-subtle": "#322f28",
      "border-strong": "#423f36",
      "footer": "#1a1915",
      "brand-blue": "#9db0d6",
