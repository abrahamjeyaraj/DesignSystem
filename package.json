{
  "name": "design-system",
  "version": "0.2.1",
  "description": "Shared design system for consumer apps: one token source, per-app themes, web + React Native + SwiftUI + Compose + Flutter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "native/*"
  ],
  "scripts": {
    "tokens": "bun packages/tokens/scripts/build.ts",
    "tokens:check": "turbo run tokens:check",
    "test": "turbo run test --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "check:native": "turbo run test build --filter=./native/*",
    "verify": "turbo run tokens:check test typecheck --filter=./packages/*",
    "build": "turbo run build --filter=./packages/*",
    "ci": "turbo run tokens:check test typecheck build",
    "release": "turbo run release --filter=./packages/* --filter=@abrahamjeyaraj/native-android"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.3",
    "turbo": "2.11.3"
  }
}
