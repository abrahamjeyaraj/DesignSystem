{
  "name": "@abrahamjeyaraj/ui-web",
  "version": "0.2.1",
  "description": "React + Radix + Tailwind v4 components (web and mobile web). Styling comes entirely from the active @abrahamjeyaraj/tokens theme.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/modules/core.ts",
      "types": "./dist/modules/core.d.ts",
      "default": "./dist/modules/core.js"
    },
    "./controls": {
      "source": "./src/modules/controls.ts",
      "types": "./dist/modules/controls.d.ts",
      "default": "./dist/modules/controls.js"
    },
    "./content": {
      "source": "./src/modules/content.ts",
      "types": "./dist/modules/content.d.ts",
      "default": "./dist/modules/content.js"
    },
    "./navigation": {
      "source": "./src/modules/navigation.ts",
      "types": "./dist/modules/navigation.d.ts",
      "default": "./dist/modules/navigation.js"
    },
    "./icons": {
      "source": "./src/modules/icons.ts",
      "types": "./dist/modules/icons.d.ts",
      "default": "./dist/modules/icons.js"
    },
    "./art": {
      "source": "./src/modules/art.ts",
      "types": "./dist/modules/art.d.ts",
      "default": "./dist/modules/art.js"
    },
    "./styles.css": "./styles.css",
    "./*": {
      "source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build ./src/index.ts ./src/*.tsx ./src/*.ts ./src/modules/*.ts --root ./src --outdir ./dist --external react --external react-dom --external react/jsx-runtime --external '@radix-ui/*' --external '@abrahamjeyaraj/*' --external lucide-react --external clsx --external tailwind-merge --external class-variance-authority && bunx tsc src/index.ts src/modules/*.ts --ignoreConfig --noEmit false --declaration --emitDeclarationOnly --outDir ./dist --jsx react-jsx --moduleResolution bundler --module esnext --target es2022 --skipLibCheck",
    "test": "bun test --conditions source test",
    "release": "bun publish --registry https://npm.pkg.github.com"
  },
  "dependencies": {
    "@abrahamjeyaraj/tokens": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^0.555.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamjeyaraj/DesignSystem.git"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ]
}
