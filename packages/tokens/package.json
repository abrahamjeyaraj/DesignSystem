{
  "name": "@abrahamjeyaraj/tokens",
  "version": "0.2.1",
  "description": "Design tokens and per-app themes (Tailwind v4 CSS, TypeScript). Generated from tokens/*.json.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./generated/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./generated/tokens.json",
    "./css/*.css": "./generated/css/*.css",
    "./base.css": "./css/base.css"
  },
  "files": [
    "dist",
    "generated/tokens.json",
    "generated/css",
    "css"
  ],
  "scripts": {
    "tokens:check": "bun scripts/build.ts --check",
    "build": "bun scripts/build.ts && bun build generated/index.ts --outdir dist && bunx tsc generated/index.ts --ignoreConfig --noEmit false --declaration --emitDeclarationOnly --outDir dist --skipLibCheck",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test --conditions source scripts",
    "release": "bun publish --registry https://npm.pkg.github.com"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamjeyaraj/DesignSystem.git"
  }
}
